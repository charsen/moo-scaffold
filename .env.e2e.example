# Playwright E2E 测试配置示例
# 复制到 .env 或设置为环境变量

# 宿主 Laravel 项目 URL（需要先启动服务）
E2E_BASE_URL=http://localhost

# Scaffold 认证账号（用于生成登录态）
E2E_USERNAME=admin
E2E_PASSWORD=your-password-here

# 宿主项目的 scaffold/database 目录（用于 safe 模式自动恢复 fixture + 真写类 test 自清）
# ⚠ 要指向 **scaffold/database/**（不是 scaffold/）—— designer.spec 会直接
#   path.resolve(dbDir, '<Schema>.yaml') 去清理自己造的 yaml，指向上一级会清不掉留残留。
# 例如: /path/to/your-host/engine/scaffold/database
E2E_HOST_SCAFFOLD_DB_PATH=

# ── 宿主 fixture 覆盖 ───────────────────────────────────────────────────────
# designer.spec 的默认值是照维护者本地 fixture（LLE）写的：schema 名 / 表名 / 字段顺序 /
# 索引配置都和那份 yaml 绑定。**换宿主时按下面几项覆盖**，不覆盖就会看到
# 「preview 返回 500（该 schema 在宿主不存在）」或「断言找不到元素」。
# 另外默认值一律保留 LLE 语义 —— 不设 = 完全维持原行为，对 LLE 是零变化。

# 首页「模块」断言接受的标识（schema key 或 UI 显示名，两种都认）
# E2E_SCHEMAS_CSV=Platform,Crm

# 只读 API smoke 用哪些 schema（必须是宿主真实存在的 yaml 文件名）
# E2E_API_SCHEMAS_CSV=Platform,Crm

# designer.spec 的主 fixture schema / 表
# E2E_SCHEMA=Platform
# E2E_TABLE=platform_regions

# 「字段表渲染」用例用的表（须含一个带 precision/size 的 decimal 字段）
# E2E_TABLE_DROPDOWN=platform_medias

# 「侧栏切表」用例点开的表（须属于 E2E_SCHEMA 且真实存在）
# E2E_TABLE_IN_LIST=platform_pages

# 「索引段」用例断言的字段（= 索引卡片里删除按钮 title 上的字段名）
# E2E_INDEX_FIELDS_CSV=parent_id

# 「字段表渲染」用例的三个期望值。E2E_FIELD_FORMAT 留空 = 跳过 format 断言
# （宿主该字段本就没有 format 属性时应当留空，硬断会假红）
# E2E_FIELD_DECIMAL_KEY=media_duration
# E2E_FIELD_PRECISION=6
# E2E_FIELD_SIZE=10
# E2E_FIELD_FORMAT=float:1000000

# ── 实例：换到另一个宿主（值按你的宿主替换）─────────────────────────────────
# 注意 E2E_INDEX_FIELDS_CSV 要按宿主的索引配置给（只配了 id/parent_id 就只写 parent_id）；
# E2E_FIELD_FORMAT 在宿主那个字段没有 format 属性时必须留空。
# E2E_BASE_URL=http://your-host.local
# E2E_SCHEMAS_CSV=<宿主真实 schema key,逗号分隔>
# E2E_API_SCHEMAS_CSV=<同上,只读 API smoke 用>
# E2E_INDEX_FIELDS_CSV=parent_id
# E2E_FIELD_FORMAT=
# E2E_HOST_SCAFFOLD_DB_PATH=/path/to/your-host/engine/scaffold/database
