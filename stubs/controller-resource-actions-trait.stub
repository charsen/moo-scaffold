<?php declare(strict_types = 1);

namespace {{namespace}};

use Illuminate\Database\Eloquent\SoftDeletes;
use Illuminate\Validation\ValidationException;
use {{base_resources}};

/**
 * 包控制器通用资源动作（软删 / 批量软删 / 永久删 / 恢复）。
 *
 * 由 moo-scaffold 生成到包内 Traits/HandlesResourceActions，供包控制器 use ——
 * 切断包对 host App\Admin\Controllers\Traits\BaseActionTrait 的反向依赖（包独立可复用）。
 * 只依赖 $this->model + BaseResource，无任何 host 耦合；需扩展在此手写即可（缺则由生成器补，已存在不覆盖）。
 *
 * @author  Charsen
 */
trait HandlesResourceActions
{
    /**
     * 删除
     */
    private function destroyAction(int|string $id): BaseResource
    {
        $result = $this->model->findOrFail($id);
        $result->delete();

        return BaseResource::make($result);
    }

    /**
     * 批量删除
     *
     * @throws ValidationException
     */
    private function destroyBatchAction($request): BaseResource
    {
        $validated = $request->validated();
        $model_ids = is_array($validated['ids']) ? $validated['ids'] : [$validated['ids']];

        $data   = $this->model->whereKey($model_ids)->get();
        $result = $data->map(function ($item) {
            if ($item->delete()) {
                return $item;
            }
        });

        if (count($result) < 1) {
            throw ValidationException::withMessages(['ids' => ['No batch operation results.']]);
        }

        return BaseResource::make($result);
    }

    /**
     * 永久删除
     *
     * 运行态守卫：非软删模型（表无 deleted_at / 模型未 use SoftDeletes）没有 onlyTrashed() /
     * forceDelete()，直接调必然 BadMethodCallException → 500。
     * 本 trait 是「每个包一份、被该包全部控制器 use」，无法按模型条件化生成；生成器已对非软删
     * 模型不生成 forceDestroy()/restore() 端点（见 controller-admin.stub 的 soft_delete_methods），
     * 本守卫兜住手写控制器仍 use 本 trait 的情形，语义与「端点不存在」一致：404。
     */
    private function forceDestroyAction(int|string $id): BaseResource
    {
        if (! in_array(SoftDeletes::class, class_uses_recursive($this->model), true)) {
            abort(404, 'The model does not support soft deletes.');
        }

        $result = $this->model->onlyTrashed()->findOrFail($id);
        $result->forceDelete();

        return BaseResource::make($result);
    }

    /**
     * 恢复
     *
     * @throws ValidationException
     */
    private function restoreAction($request): BaseResource
    {
        if (! in_array(SoftDeletes::class, class_uses_recursive($this->model), true)) {
            abort(404, 'The model does not support soft deletes.');
        }

        $validated = $request->validated();
        $model_ids = is_array($validated['ids']) ? $validated['ids'] : [$validated['ids']];

        $data   = $this->model->onlyTrashed()->whereKey($model_ids)->get();
        $result = $data->map(function ($item) {
            if ($item->restore()) {
                return $item;
            }
        });

        if (count($result) < 1) {
            throw ValidationException::withMessages(['ids' => ['No batch operation results.']]);
        }

        return BaseResource::make($result);
    }
}
