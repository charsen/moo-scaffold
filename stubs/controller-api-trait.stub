 * @LastEditTime: {{date}}
 * @Description: {{controller_name}}Controller's Trait
 */

namespace {{namespace}};

use {{model_class}};
use Mooeen\Scaffold\Foundation\FormRequest;
use Mooeen\Scaffold\Foundation\FormWidgetCollection;
use Mooeen\Scaffold\Foundation\TableColumnsCollection;

trait {{trait_class}}
{
    /**
     * 列表的查询字段
     *
     * 非 index 分支供 trashed 类动作取列；本表无 `deleted_at` 时由生成器置空 ——
     * select 不存在的列会让端点 500（api 控制器当前无 trashed 动作，仍保持同一口径）。
     */
    private function getListFields($action = 'index'): array
    {
        $fields = [{{list_fields}}];

        if ($action === 'index') {
            $append = ['updated_at'];
        } else {
            $append = [{{trashed_list_append}}];
        }

        return [...$fields, ...$append];
    }


    /**
     * 列表的表头
     */
    private function getListColumns($action = 'index'): TableColumnsCollection
    {
        $columns = [
            {{list_columns}}
        ];

        return TableColumnsCollection::makeColumns($columns, $action);
    }

    /**
     * 列表的表单控件
     */
    private function getListFormWidgets(FormRequest $request, string $action = 'index', array $override = []): FormWidgetCollection
    {
        $base = [];

        return FormWidgetCollection::makeSearch($request, $base, override: $override);
    }

}
